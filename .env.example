# .env.example — committed. It lists the variables; it never holds real values.
#
# .env        → used by `podman compose up` (local stack with its own PostgreSQL)
DB_PASSWORD=
#
# .env.cloud  → used in Session 14 to run the image locally against Supabase:
#               podman run --rm -p 3000:8000 --env-file .env.cloud notes:dev
#               One line, no quotes, no spaces around "=":
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
